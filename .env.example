# Stake Rotator — environment variables
# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Solana RPC — used by Phase 1.2 (epoch-boundary webhooks) and Phase 2 balance reads.
# Free Helius tier works for development.
HELIUS_RPC_URL=

# Sanctum extra-api base. Override only if you're pointing at a different deployment.
# Default in code: https://extra-api.sanctum.so/v1
SANCTUM_API_BASE=

# Jupiter swap API base. Override only if you're pointing at the paid endpoint.
# Default in code: https://lite-api.jup.ag/swap/v1
JUPITER_API_BASE=

# Telegram bot token from @BotFather. Required for `pnpm bot`.
TELEGRAM_BOT_TOKEN=

# Postgres connection string. Required for `pnpm bot` and `pnpm migrate`.
# Example: postgres://user:pass@localhost:5432/stake_rotator
DATABASE_URL=

# Optional: public HTTPS host for the Solana Actions endpoint (e.g. https://rotator.example.com).
# When set, /rotate emits a `solana-action:` URL and the bot starts an HTTP server on ACTIONS_PORT.
# When unset, /rotate falls back to returning the base64 unsigned tx in the chat.
BOT_PUBLIC_HOST=
ACTIONS_PORT=8787

# Phase 4 worker — used by `pnpm worker`.
# Path to a JSON keypair file (Solana CLI format) for the bot's rotation authority.
BOT_KEYPAIR_PATH=
# Worker poll interval in ms. Default 300000 (5 min). Replace with epoch webhook in prod.
WORKER_TICK_MS=300000
